{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "dujsjhdjdjs.practice-mod",
    "name": "Practice Mod",
    "version": "v1.0.4",
    "developer": "dujsjhdjdjs",
    "description": "Practice menu with noclip, speed and macros",
    "dependencies": {
        "geode.node-ids": ">=v1.23.3"
    },
    "settings": {
        "hide-menu": {
            "type": "bool",
            "name": "Hide Practice Menu",
            "description": "Turn this on to hide the PM button everywhere. Turn it off to bring it back.",
            "default": false
        },
        "show-outside": {
            "type": "bool",
            "name": "Show menu on main menu",
            "default": true
        },
        "show-in-editor": {
            "type": "bool",
            "name": "Show menu in editor",
            "default": false
        }
    }
}
